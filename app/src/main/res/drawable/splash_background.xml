<?xml version="1.0" encoding="utf-8"?>
<!--
    Coral's splash screen background.
    Just the dark gray surface (#121212) — same as the app surface.
    This makes the launch feel seamless: icon → splash → app, all the
    same color, no flash. Compose draws over it within ~100ms.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
        </shape>
    </item>
</layer-list>
